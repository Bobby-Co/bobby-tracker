# Copy to .env.local. Compose-style (`KEY=value`); restart `next dev` to pick up changes.

# ─── Supabase (shared with Bobby/service) ──────────────────────────────────
# Use the SAME Supabase project as the Bobby CI app — that's how users get
# single-sign-on. The `tracker` schema must be added to API → Exposed schemas
# in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-only service-role key. NOT required by any current
# tracker route — progress writes during indexing happen on the
# analyser side using its own SUPABASE_SERVICE_ROLE_KEY env var. Keep
# this slot for future admin-only tracker routes (none today).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Shared auth cookie ────────────────────────────────────────────────────
# Set to the parent domain of BOTH apps so the session cookie is shared.
# Examples:
#   tracker.bobby.example.com + bobby.example.com → ".bobby.example.com"
#   tracker.example.com       + ci.example.com    → ".example.com"
# Leave empty in local dev (different ports don't share cookies; just sign in
# to each app separately on localhost).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# ─── bobby-analyser microservice ───────────────────────────────────────────
# URL of the analyser server (the container from Phase 1). Reachable from
# the tracker's server-side runtime; never exposed to browsers.
BOBBY_ANALYSER_URL=https://analyser.example.com
BOBBY_ANALYSER_TOKEN=
# Note: AI issue compose (vision) + embeddings live on the analyser
# now — declare them in the analyser's config.yaml under providers +
# routing.compose / routing.embed (see bobby-analyser README), not here.

# ─── Regions and cells (migration 0062) ────────────────────────────────────
# Two levels, and they do different jobs:
#
#   region  'south-east-asia'  coarse geography. What the CUSTOMER picks, what a
#                              residency question is answered in, what the UI
#                              shows.
#   cell    'bangkok-0'        one deployment unit with one analyser behind it.
#                              What the app ROUTES on. Internal — assigned by the
#                              app, never chosen by or shown to a user.
#
# Adding capacity in a region = declaring another cell here. No code change, no
# migration, no deploy: the ids are open slugs validated by format, and the
# registry is the only thing that decides what exists.
#
# SINGLE-CELL DEPLOYS NEED NOTHING BELOW. With BOBBY_CELLS unset the topology is
# one cell (the home cell) in one region, served by the unsuffixed pair above —
# exactly today's behaviour.

# The home cell: where every pre-0062 project lives, and which analyser serves
# work that touches no repo graph (embeddings, issue compose). Must match the
# `cell` default in migration 0062. Defaults to ashburn-0 / north-america.
BOBBY_HOME_CELL=ashburn-0
BOBBY_HOME_REGION=north-america

# The topology: comma-separated `cell:region` pairs. Order is preference order —
# assignCell() places a new project on the first configured cell in its region.
# BOBBY_CELLS=ashburn-0:north-america,bangkok-0:south-east-asia,bangkok-1:south-east-asia

# Per-cell analyser endpoints. Suffix = the cell id, uppercased, hyphens →
# underscores (bangkok-0 → BANGKOK_0).
#
# A non-home cell does NOT inherit the unsuffixed pair. That is deliberate: a
# half-configured cell must fail loudly rather than quietly send Bangkok's work
# to Virginia. A cell with no URL is skipped by assignCell() and its region is
# not offered to users at all.
# BOBBY_ANALYSER_URL_BANGKOK_0=https://bkk0.analyser.example.com
# BOBBY_ANALYSER_TOKEN_BANGKOK_0=

# Optional display overrides; both are otherwise derived from the id
# (south-east-asia → "South East Asia", bangkok-0 → "Bangkok 0").
# BOBBY_REGION_LABEL_SOUTH_EAST_ASIA=Southeast Asia
# BOBBY_CELL_LABEL_BANGKOK_0=Bangkok (primary)

# ─── Email notifications (Stalwart JMAP) ───────────────────────────────────
# Optional. When STALWART_JMAP_URL (+ auth + EMAIL_FROM) is set, the project
# owner is emailed for feed events (PR reviewed/opened, KB ready/updated) in
# addition to the in-app bell. Leave STALWART_JMAP_URL empty to disable email
# entirely — every send path no-ops without it.
#
# Transport: plain HTTPS to Stalwart's JMAP API (RFC 8620/8621) — no SMTP, no
# sockets. Works in `next dev` too. Set the secret(s) as Worker secrets in
# production (`wrangler secret put STALWART_JMAP_TOKEN`), not committed vars.
#
# Base host (we derive /.well-known/jmap) or a full JMAP session URL.
STALWART_JMAP_URL=https://mail.example.com
# Auth — EITHER a bearer/API token (preferred) …
STALWART_JMAP_TOKEN=
# … OR Basic-auth account credentials (used only if TOKEN is empty).
STALWART_JMAP_USER=
STALWART_JMAP_PASS=
# Sender. "Name <addr>" or a bare address; must be an allowed sender for the
# authenticated account. Falls back to STALWART_JMAP_USER when empty.
EMAIL_FROM=Ucelot <notifications@example.com>

# Shared secret authenticating the DB→app notification callback. Every
# notification insert fires a Postgres trigger (migration 0051, via pg_net) that
# POSTs to /api/internal/notification-email; the route checks this token. It must
# EQUAL the value stored in tracker.app_config.notify_email_token. Set it as a
# Worker secret in production (`wrangler secret put NOTIFY_EMAIL_TOKEN`).
#
# One-time DB setup to turn email on for ALL notification kinds (PR reviewed, PR
# opened, KB ready/updated) — run once against the shared Supabase DB:
#   insert into tracker.app_config (key, value) values
#     ('notify_email_url',   'https://<app-host>/api/internal/notification-email'),
#     ('notify_email_token', '<same value as NOTIFY_EMAIL_TOKEN below>')
#   on conflict (key) do update set value = excluded.value;
NOTIFY_EMAIL_TOKEN=

# ─── Public app URL ────────────────────────────────────────────────────────
# Absolute base URL for links in outbound email (e.g. the "view review" button).
# REQUIRED for email links: the notification-email callback is DB-driven and has
# no request origin to fall back on, so an unset value leaves links relative.
#
# ALSO REQUIRED by the MCP OAuth authorization server (modules/mcp-oauth). It is
# the `issuer`, the base of every endpoint in the discovery documents, the `iss`
# stamped on each authorization redirect (RFC 9207), and the canonical resource
# identifier `<NEXT_PUBLIC_APP_URL>/api/mcp`. It is read from config rather than
# derived from the inbound Host header on purpose — a request-derived issuer is
# how AS-mixup and discovery-poisoning attacks start. With this unset, the
# /.well-known/* documents answer 503 and /oauth/authorize refuses to run.
# No scheme-less or trailing-slash forms: use e.g. https://tracker.example.com
NEXT_PUBLIC_APP_URL=

# ─── MCP OAuth authorization server ────────────────────────────────────────
# NO ADDITIONAL SECRETS ARE NEEDED. Access/refresh tokens are OPAQUE random
# strings (Web Crypto), stored only as SHA-256 hashes in tracker.mcp_oauth_tokens
# — there is no JWT and therefore no signing key to configure or rotate. The
# server reaches those tables with SUPABASE_SERVICE_ROLE_KEY (above), which must
# be set for the token/register/revoke endpoints to work at all.
#
# Optional but recommended in production: the `PUBLIC_RL` rate-limit binding in
# wrangler.jsonc covers /api/oauth/register, /token and /revoke. Without it those
# endpoints fail open (see lib/server/RateLimiter.ts).
